# =============================================================================
# KDP STUDIO — ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. REQUIRED CORE SYSTEM VARIABLES
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_web_app_id

FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

GEMINI_API_KEY=your_gemini_api_key
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com
REVALIDATE_SECRET=generate_a_random_revalidation_secret
CRON_SECRET=generate_a_random_cron_secret

# ─────────────────────────────────────────────────────────────────────────────
# 2. PAYMENT GATEWAYS
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

BMAC_ACCESS_TOKEN=
BMAC_WEBHOOK_SECRET=
NEXT_PUBLIC_BMAC_URL=https://buymeacoffee.com/x4kqsD0lkA

UPI_ID=
UPI_DISPLAY_NAME="KDP Studio"
NEXT_PUBLIC_UPI_QR_CODE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# 3. TRANSACTIONAL EMAIL (Resend)
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxx
EMAIL_FROM="KDP Studio <noreply@yourdomain.com>"
EMAIL_REPLY_TO="support@yourdomain.com"
DEV_EMAIL_TO=
